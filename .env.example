# Optional API Keys for cloud LLM generation backends
# If not provided, the pipeline operates 100% offline using the built-in extractive synthesizer or local HuggingFace models.

# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Default settings override
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_LLM_PROVIDER=fallback
