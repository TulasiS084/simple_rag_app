# ==============================================================================
# Development Dockerfile for Express.js Backend (Hot Reload enabled)
# Base image: node:20.17.0-alpine (explicit version tag pinned)
# ==============================================================================
FROM node:20.17.0-alpine

WORKDIR /app

# Set development environment defaults
ENV NODE_ENV=development \
    PORT=5000 \
    MONGO_URI="" \
    JWT_SECRET=""

# Copy dependency manifests
COPY package*.json ./

# Install all dependencies including devDependencies (nodemon)
RUN npm install

# Copy application source code
COPY . .

# Run as non-root user (node user with UID 1000 is built-in to alpine node)
USER node

# Expose backend port
EXPOSE 5000

# Health check instruction calling /health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:5000/health || exit 1

# Start development server with nodemon hot-reload
CMD ["npm", "run", "dev"]
